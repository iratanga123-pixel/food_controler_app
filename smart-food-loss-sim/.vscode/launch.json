{
  // Run buttons for the Run and Debug panel (Ctrl+Shift+D). Pick one from the list and press F5.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Create training data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/make_dataset.py",
      "args": ["--stores", "800"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "2. Train AI model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train_model.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "3. Virtual sensors (live)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/simulator.py",
      "args": ["--live", "--interval", "3"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "4. Dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "dashboard.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Predict once (no dashboard)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/predictor.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Run full system (sensors + dashboard)",
      "configurations": ["3. Virtual sensors (live)", "4. Dashboard"],
      "stopAll": true
    }
  ]
}
